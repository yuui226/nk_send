<resources>
    <string name="monitor_help_title">监看说明</string>
    <string name="monitor_help_section_basic">基本操作</string>
    <string name="monitor_help_section_camera">相机控制</string>
    <string name="monitor_help_section_exposure">曝光与色彩</string>
    <string name="monitor_help_section_display">画面辅助</string>
    <string name="monitor_help_section_layout">布局与工具</string>
    <string name="monitor_help_capture_label">拍照与相机录像</string>
    <string name="monitor_help_capture">圆形快门按钮可以拍照、开始或停止录像；长按对焦，松手拍摄，移出按钮取消。</string>
    <string name="monitor_help_focus_label">画面操作</string>
    <string name="monitor_help_focus">追焦功能下，点击画面选择追焦目标，再点一次取消追焦。双指缩放，放大后可拖动，双击还原。</string>
    <string name="monitor_help_parameters_label">拍摄参数</string>
    <string name="monitor_help_parameters">按住拨轮上下拖动可快速调节曝光补偿、ISO、光圈和快门速度；ISO 上的 AUTO 按钮为自动 ISO 开关。</string>
    <string name="monitor_help_review_label">回看</string>
    <string name="monitor_help_review">照片模式下查看最新照片：左右翻页，双击或双指缩放，单击退出。同名 JPG+NEF 只显示一次。</string>
    <string name="monitor_help_status_label">连接与电量</string>
    <string name="monitor_help_status">顶部显示连接状态；电池可查看剩余电量。</string>
    <string name="monitor_help_tool_hd">切换监看清晰度，不改变相机照片和录像的画质。</string>
    <string name="monitor_help_tool_fps">显示监看每秒收到的画面数，不是相机录像帧率。</string>
    <string name="monitor_help_tool_audio">显示相机左右声道的音量，仅录像模式可用。</string>
    <string name="monitor_help_tool_histogram">看画面明暗分布：左暗右亮。点按切换 RGB（红绿蓝）、亮度或关闭。</string>
    <string name="monitor_help_tool_grid">选择参考线帮助构图。</string>
    <string name="monitor_help_tool_exposure">斑马纹标出亮部，伪色用颜色区分明暗。点按依次切换两种效果或关闭。</string>
    <string name="monitor_help_tool_desqueeze">使用变形宽银幕镜头时，按镜头倍率拉宽画面；普通镜头选 1×。</string>
    <string name="monitor_help_tool_level">显示相机是否倾斜，帮助保持画面水平。</string>
    <string name="monitor_help_tool_white_balance">调整相机白平衡。</string>
    <string name="monitor_help_tool_focus_area">选择画面中参与对焦的范围，如单点或宽区域。</string>
    <string name="monitor_help_tool_waveform">横向对应画面位置，波形越高越亮。点按切换亮度、RGB 或关闭。</string>
    <string name="monitor_help_tool_focus_mode">选择单次、连续或手动对焦等方式。</string>
    <string name="monitor_help_tool_focus_frame">显示或隐藏对焦框。</string>
    <string name="monitor_help_tool_lut">选含 .cube 文件的文件夹，支持文件夹中一层子文件夹作分类。只改变监看颜色，不会影响相机产出的照片或视频，不能与伪色同用。</string>
    <string name="monitor_help_tool_picture_control">支持已有预设切换，点槽位对应画笔更换或清除。可用内置或文件夹中的 .np3，暂不支持灵活色彩的 .np3。</string>
    <string name="monitor_help_tool_meter">看相机的曝光指示，判断曝光偏亮还是偏暗。</string>
    <string name="monitor_help_tool_lock">固定当前横竖屏方向，解锁后才能旋转；不影响拍摄操作。</string>
    <string name="monitor_help_tool_computer_control">部分机型开启后可调更多参数，机身操作可能受限。退出监看会解除。</string>
    <string name="monitor_help_tool_rotate">切换竖屏或左右横屏；锁定时先解锁。</string>
    <string name="monitor_help_manage">管理小工具显隐与顺序，拖动排序，点按显示或隐藏。照片、录像分别记住布局；隐藏辅助工具会关闭其效果。锁定和旋转不能移动或隐藏。</string>
    <string name="monitor_help_disp_label">横屏 DISP</string>
    <string name="monitor_help_disp">切换显示在监看画面上的信息。</string>
</resources>
