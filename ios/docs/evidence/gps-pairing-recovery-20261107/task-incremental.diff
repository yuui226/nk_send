+        if exact.count == 1 { return exact[0].id }
+        let filter = NikonGPSAccessoryPairing.nameFilter(cameraName)
+        let matches = candidates.filter { $0.name.map { filter.evaluate(with: $0) } ?? false }
+        return matches.count == 1 ? matches[0].id : nil
+    }
