+    @MainActor
+    func testDirectBLEProbeCancellationDiscardsCandidateAndRejectsLateGEO() async throws {
+        for action in ["stop", "clear", "adapter", "failure", "timeout"] {
+            let suite = "GPSDirectProbeCancel-\(UUID())", defaults = UserDefaults(suiteName: suite)!
+            defer { defaults.removePersistentDomain(forName: suite) }
+            let pairing = GPSControlledSystemPairing(), clock = GPSDeferredClock()
+            let client = NikonGPSBluetoothClient(defaults: defaults, sleep: { await clock.wait($0) },
+                centralFactory: { _, _ in CBCentralManager(delegate: nil, queue: .main) },
+                systemPairing: pairing, pairingRoute: .directBLEProbe)
+            defer { client.stop() }
+            client.start(); _ = client.preparePairingIdentity(); _ = client.takeControllerIDPayload()
+            client.controllerIDDidWrite(cameraName: "Nikon test") {}
+            _ = client.preparePairingIdentity(); _ = client.takeControllerIDPayload()
+            client.controllerIDDidWrite(cameraName: "Nikon test") {}
+            for _ in 0..<100 where await clock.count == 0 { try await Task.sleep(for: .milliseconds(5)) }
+            let delays = await clock.delays
+            XCTAssertEqual(delays, [45_000_000_000])
+            switch action {
+            case "clear": client.clearPairing()
+            case "adapter": client.invalidateAdapterConnection()
+            case "failure": client.failConnection("GATT rejected GPS")
+            case "timeout": break
+            default: client.stop()
+            }
+            await clock.release(0)
+            for _ in 0..<20 { await Task.yield() }
+            client.confirmIdentityAfterGeoWrite()
+            XCTAssertFalse(client.hasPairingIdentity, action)
+            XCTAssertFalse(client.hasSavedPairing, action)
+            XCTAssertNil(defaults.object(forKey: GPSPreferences.deviceID), action)
+            XCTAssertNil(defaults.object(forKey: GPSPreferences.nonce), action)
+            XCTAssertNil(defaults.object(forKey: GPSPreferences.pairingConfirmed), action)
+            XCTAssertTrue(pairing.names.isEmpty, action)
+            if action == "failure" || action == "timeout" {
+                guard case .failed(let reason) = client.state else { XCTFail(action); continue }
+                XCTAssertTrue(GPSBluetoothFailurePolicy(reason).waitsForPairing)
+                XCTAssertFalse(GPSBluetoothFailurePolicy(reason).retries)
+                XCTAssertFalse(client.isRunning)
+            }
+        }
+    }
