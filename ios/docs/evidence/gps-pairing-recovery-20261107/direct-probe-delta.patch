     @MainActor
+    func testDirectBLEProbeSkipsPickerAndPersistsOnlyAfterReconnectedGEOAcknowledgement() async throws {
+        let suite = "GPSDirectProbe-\(UUID())", defaults = UserDefaults(suiteName: suite)!
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let pairing = GPSControlledSystemPairing(), clock = GPSDeferredClock()
+        let client = NikonGPSBluetoothClient(defaults: defaults, sleep: { await clock.wait($0) },
+            centralFactory: { _, _ in CBCentralManager(delegate: nil, queue: .main) },
+            systemPairing: pairing, pairingRoute: .directBLEProbe)
+        defer { client.stop() }
+        var events: [NikonGPSBluetoothState] = []
+        let observer = client.statePublisher.sink { events.append($0) }
+        defer { observer.cancel() }
+        client.start()
+        let proposal = client.preparePairingIdentity()
+        _ = client.takeControllerIDPayload()
+        var closes = 0
+        client.controllerIDDidWrite(cameraName: "Z50_2_test") { closes += 1 }
+        client.controllerIDDidWrite(cameraName: "Z50_2_test") { XCTFail("Repeated ACK") }
+        XCTAssertEqual(closes, 1)
+        XCTAssertEqual(Array(events.suffix(2)), [.verifyingPairing("Z50_2_test"), .disconnected])
+        XCTAssertTrue(pairing.names.isEmpty)
+        XCTAssertTrue(client.hasPairingIdentity)
+        XCTAssertFalse(client.hasSavedPairing)
+        client.confirmIdentityAfterGeoWrite()
+        XCTAssertNil(defaults.object(forKey: GPSPreferences.deviceID))
+        XCTAssertFalse(NikonGPSBluetoothClient(defaults: defaults).hasPairingIdentity)
+        let reconnect = client.preparePairingIdentity()
+        XCTAssertEqual(reconnect.device, proposal.device)
+        XCTAssertEqual(reconnect.nonce, proposal.nonce)
+        _ = client.takeControllerIDPayload()
+        client.controllerIDDidWrite(cameraName: "Z50_2_test") { XCTFail("Ready connection must remain open") }
+        XCTAssertEqual(client.state, .ready("Z50_2_test"))
+        XCTAssertFalse(client.hasSavedPairing)
+        XCTAssertNil(defaults.object(forKey: GPSPreferences.pairingVerificationPending))
+        for _ in 0..<100 where await clock.count == 0 { try await Task.sleep(for: .milliseconds(5)) }
+        client.confirmIdentityAfterGeoWrite()
+        XCTAssertTrue(client.hasSavedPairing)
+        XCTAssertEqual(defaults.integer(forKey: GPSPreferences.deviceID), Int(proposal.device))
+        XCTAssertEqual(defaults.integer(forKey: GPSPreferences.nonce), Int(proposal.nonce))
+        XCTAssertTrue(defaults.bool(forKey: GPSPreferences.pairingConfirmed))
+        XCTAssertNil(defaults.object(forKey: GPSPreferences.pairingVerificationPending))
+        await clock.release(0)
